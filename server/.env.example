# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# If left empty, iMovies automatically spins up an embedded Mongo instance for development/testing
MONGODB_URI=

# Authentication
JWT_SECRET=imovies_super_secret_jwt_key_development_2026_xyz!@#
JWT_EXPIRES_IN=7d
COOKIE_SECRET=imovies_cookie_signing_secret_987654321

# Payment Configuration
# Set PAYMENT_MODE to 'mock' for local development simulation, or 'razorpay' for live/test Razorpay API
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Booking Settings
SEAT_HOLD_DURATION_MINUTES=5
CANCELLATION_CUTOFF_HOURS=2
CANCELLATION_REFUND_PERCENT=85
CONVENIENCE_FEE_PER_TICKET=2500
GST_RATE_PERCENT=18
